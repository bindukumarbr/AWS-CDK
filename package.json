{
  "name": "orders-platform-cdk",
  "version": "1.0.0",
  "private": true,
  "description": "Minimal, production-shaped AWS CDK (TypeScript) reference platform: VPC, ECS Fargate + ALB, RDS, API Gateway + Lambda + DynamoDB, observability, GitHub Actions OIDC pipeline with security gates.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "test": "jest",
    "synth:dev": "cdk synth --quiet -c stage=dev",
    "synth:prod": "cdk synth --quiet -c stage=prod",
    "diff:dev": "cdk diff --all -c stage=dev",
    "deploy:dev": "cdk deploy --all -c stage=dev",
    "destroy:dev": "cdk destroy --all -c stage=dev",
    "audit:prod": "npm audit --omit=dev --audit-level=high"
  },
  "dependencies": {
    "aws-cdk-lib": "^2.273.0",
    "cdk-nag": "^3.0.2",
    "constructs": "^10.8.1"
  },
  "devDependencies": {
    "@aws-sdk/client-dynamodb": "^3.1152.0",
    "@aws-sdk/lib-dynamodb": "^3.1152.0",
    "@swc/core": "^1.16.18",
    "@swc/jest": "^0.2.39",
    "@types/aws-lambda": "^8.10.164",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.19.2",
    "aws-cdk": "^2.1145.0",
    "esbuild": "^0.28.2",
    "jest": "^30.5.2",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2"
  }
}
